{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/v1(?:/(.*))?",
      "dest": "/api/index.js"
    },
    {
      "src": "/health(?:/(.*))?",
      "dest": "/api/index.js"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
